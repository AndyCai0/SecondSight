# Supabase injects SUPABASE_URL and its server-side key automatically in hosted
# and local Edge Function runtimes. The CLI rejects SUPABASE_* overrides here.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
# AI stays disabled unless this server-only key is configured.
# DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
ASSEMBLYAI_API_KEY=YOUR_ASSEMBLYAI_API_KEY
